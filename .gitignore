# Vitis HLS 独立综合验证工程（仅限仓库根目录）
/vitis_hls_*_csynth_*/

# Vitis HLS 与 Vivado 工具日志
**/vitis_hls*.log
**/vivado*.log
**/vivado*.jou

# Xilinx 工具缓存与综合数据库
**/.Xil/
**/.autopilot/

# Vitis HLS Solution 生成目录
**/solution*/syn/
**/solution*/csim/
**/solution*/sim/
**/solution*/impl/
**/solution*/.debug/

# Vitis HLS Solution 状态与报告索引文件
**/solution*/solution*.aps
**/solution*/solution*.log
**/solution*/solution*.directive
**/solution*/solution*_data.json

# 集中保存的 HLS 运行工程与日志；禁止生成物回到源码树
/build/hls/
/vitis_hls_*/
/vitis_hls*.log
/hls/vitis_hls*.log
/hls/.Xil/

# Vivado 工程可重生成的缓存、运行与仿真输出（仅限 vivado/）
/vivado/**/*.cache/
/vivado/**/*.runs/
/vivado/**/*.sim/
/vivado/**/*.hw/
/vivado/**/*.ip_user_files/
/vivado/**/vivado_pid*.str
/vivado/hs_err_pid*.log
/vivado/xrc.log
/vivado/.Rhistory
# 工具日志可能出现在工程根或隐藏 .log 目录，不只叫 vivado.log。
/vivado/**/*.log
/vivado/**/*.jou

# 保留 XPR 原地引用的顶层 wrapper，其余 .gen 内容由 Vivado 重生成。
# 逐级开放父目录；通配忽略规则仍作用于各层的其他文件和子目录。
/vivado/**/*.gen/**
!/vivado/cnn_accel_ddr/cnn_accel_ddr.gen/sources_1/
!/vivado/cnn_accel_ddr/cnn_accel_ddr.gen/sources_1/bd/
!/vivado/cnn_accel_ddr/cnn_accel_ddr.gen/sources_1/bd/system/
!/vivado/cnn_accel_ddr/cnn_accel_ddr.gen/sources_1/bd/system/hdl/
!/vivado/cnn_accel_ddr/cnn_accel_ddr.gen/sources_1/bd/system/hdl/system_wrapper.v

# 此 Vitis 工作区：保留源码/工程描述/XSA/BSP 配置，排除可重新生成内容。
/vivado/cnn_accel_ddr/vitis/.workspace
/vivado/cnn_accel_ddr/vitis/.metadata/
/vivado/cnn_accel_ddr/vitis/.analytics
/vivado/cnn_accel_ddr/vitis/IDE.log
/vivado/cnn_accel_ddr/vitis/RemoteSystemsTempFiles/
/vivado/cnn_accel_ddr/vitis/**/Debug/
/vivado/cnn_accel_ddr/vitis/**/Release/
/vivado/cnn_accel_ddr/vitis/**/_ide/
/vivado/cnn_accel_ddr/vitis/**/.log/
/vivado/cnn_accel_ddr/vitis/**/tempdsa/
/vivado/cnn_accel_ddr/vitis/**/*.elf
/vivado/cnn_accel_ddr/vitis/system_wrapper/export/
/vivado/cnn_accel_ddr/vitis/system_wrapper/logs/

# XSA 解包副本（驱动、bitstream、ps7_init 等）；平台描述引用的内部 XSA 保留。
/vivado/cnn_accel_ddr/vitis/system_wrapper/hw/*
!/vivado/cnn_accel_ddr/vitis/system_wrapper/hw/system_wrapper.xsa

# BSP 源码/头/库及构建规则由平台重生成；只保留可编辑配置 system.mss。
# 不忽略 BSP 父目录，确保配置例外能生效；不影响 FSBL 自身源码与 Makefile。
/vivado/cnn_accel_ddr/vitis/system_wrapper/ps7_cortexa9_0/standalone_ps7_cortexa9_0/bsp/*
!/vivado/cnn_accel_ddr/vitis/system_wrapper/ps7_cortexa9_0/standalone_ps7_cortexa9_0/bsp/system.mss
/vivado/cnn_accel_ddr/vitis/system_wrapper/zynq_fsbl/zynq_fsbl_bsp/*
!/vivado/cnn_accel_ddr/vitis/system_wrapper/zynq_fsbl/zynq_fsbl_bsp/system.mss
