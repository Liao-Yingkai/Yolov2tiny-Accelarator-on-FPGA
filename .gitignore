# 本机编辑器配置，不影响工程源码或构建配置。
**/.vscode/

# Python 辅助脚本缓存和编辑器临时文件，不影响脚本或模型配置头。
**/__pycache__/
*.pyc
*.pyo
*.swp
*.swo
*~
.DS_Store

# 本地模型与测试数据副本；源码、数据说明和小型PS配置头仍跟踪。
/data/yolov2_tiny/*
!/data/yolov2_tiny/README.md

# Vitis HLS 独立综合验证工程（仅限仓库根目录）
/vitis_hls_*_csynth_*/

# Vitis HLS 与 Vivado 工具日志
**/vitis_hls*.log
**/vivado*.log
**/vivado*.jou

# Xilinx 工具缓存与综合数据库
**/.Xil/
**/.autopilot/

# Vitis HLS Solution 生成目录
**/solution*/syn/
**/solution*/csim/
**/solution*/sim/
**/solution*/impl/
**/solution*/.debug/

# Vitis HLS Solution 状态与报告索引文件
**/solution*/solution*.aps
**/solution*/solution*.log
**/solution*/solution*.directive
**/solution*/solution*_data.json

# 集中保存的 HLS 运行工程与日志；禁止生成物回到源码树
/build/hls/
# PS 裸机编译、链接及主机验证生成物。
/build/ps/
/vitis_hls_*/
/vitis_hls*.log
/hls/vitis_hls*.log
/hls/.Xil/
# 旧 testbench 的可重生成数据；当前测试只读 BIN，不再导出 CSV。
/hls/**/simulation_data/

# Vivado 工程可重生成的缓存、运行与仿真输出（仅限 vivado/）
/vivado/**/*.cache/
/vivado/**/*.runs/
/vivado/**/*.sim/
/vivado/**/*.hw/
/vivado/**/*.ip_user_files/
/vivado/**/vivado_pid*.str
/vivado/hs_err_pid*.log
/vivado/xrc.log
/vivado/.Rhistory
# 工具日志可能出现在工程根或隐藏 .log 目录，不只叫 vivado.log。
/vivado/**/*.log
/vivado/**/*.jou
# PS 配置器导出的本机摘要报告，不是工程源文件。
/vivado/NA/
/vivado/**/ps7_summary.html

# .gen 内容由 Vivado 重生成；当前摄像头工程的 wrapper 保存在 .srcs 内。
/vivado/**/*.gen/**

# Vitis 本地工作区及生成物。旧位置只允许本机路径兼容链接。
/vivado/cnn_accel_cam/vitis
/vitis/**/.nfs*
/vitis/**/*.log
/vitis/**/*.jou
/vitis/.workspace
/vitis/.metadata/
/vitis/.analytics
/vitis/IDE.log
/vitis/RemoteSystemsTempFiles/
/vitis/**/Debug/
/vitis/**/Release/
/vitis/**/_ide/
# Vitis 生成的平台/FSBL工作副本；正式平台描述和FSBL源仍保留。
/vitis/*/_platform/
/vitis/**/.log/
/vitis/**/tempdsa/
/vitis/**/*.elf
/vitis/*/export/
/vitis/*/logs/
# IDE包管理器的仓库索引，不是工程源码或启动镜像配置。
/vivado/*/Packages/.repos.xml

# 平台 hw 的解包副本可重生成；保留平台描述引用的内部硬件交接 XSA。
/vitis/*/hw/*
!/vitis/*/hw/*.xsa

# 仅排除 BSP 生成内容，不影响应用、自定义 IP 或 FSBL 自身源码。
/vitis/*/ps7_cortexa9_0/*/bsp/*
!/vitis/*/ps7_cortexa9_0/*/bsp/system.mss
/vitis/*/zynq_fsbl/zynq_fsbl_bsp/*
!/vitis/*/zynq_fsbl/zynq_fsbl_bsp/system.mss

# NFS 延迟删除的工具临时文件；不删除本地正在使用的文件。
/vivado/**/.nfs*
